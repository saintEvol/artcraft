; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="game-assets-godot-m0"
config/description="Loads the M0 game-asset pack fixture (PNG + GLB) through Godot's normal import pipeline. Headless check: godot --headless --import --path . && godot --headless --path . --script res://validation/m0_load_check.gd"
run/main_scene="res://validation/m0_visual_check.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/game_assets/plugin.cfg")
